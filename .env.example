# Requires PostgreSQL 18. Special characters in the password must be URL-encoded (@ -> %40, + -> %2B).
DATABASE_URL="postgresql://lemak_cafe_admin:YOUR_PASSWORD@localhost:5432/lemak_cafe_dashboard?schema=public"

# At least 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-of-32-chars-or-more"

# Seeded users: email:password:name, separated by commas. Change these passwords.
SEED_USERS="owner@lemak.cafe:change-me-1:Owner,staff@lemak.cafe:change-me-2:Staff"
