# Copy to .env.production ON THE SERVER ONLY. Never commit the real file.
# Compose reads this for ${...} substitution, so wrap values containing `$` in single quotes.

# Public domain that Nginx serves (DNS A record must point at this server).
DOMAIN=cafe.example.com
# Host directory holding fullchain.pem and privkey.pem (certbot: /etc/letsencrypt/live/<domain>).
TLS_CERT_DIR=/etc/letsencrypt/live/cafe.example.com

# PostgreSQL 18 container.
POSTGRES_USER=lemak_cafe_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lemak_cafe_dashboard

# Must match the three values above. The host is the compose service name `db`.
# URL-encode special characters in the password (@ -> %40, + -> %2B, / -> %2F).
DATABASE_URL=postgresql://lemak_cafe_admin:change-me@db:5432/lemak_cafe_dashboard?schema=public

# At least 32 characters: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
